# Copy these values to a local, Git-ignored .env file and replace placeholders locally.
# MybatisUtil accepts JVM properties first, then these environment variables.
HOSPITAL_DB_DRIVER=com.oceanbase.jdbc.Driver
HOSPITAL_DB_URL=jdbc:oceanbase://127.0.0.1:2881/hospt?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
HOSPITAL_DB_USERNAME=hospital_app@test
HOSPITAL_DB_PASSWORD=<database-password>
