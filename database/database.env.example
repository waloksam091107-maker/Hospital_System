# Do not commit this file after entering a real password.
# MybatisUtil accepts JVM properties first, then these environment variables.
HOSPITAL_DB_DRIVER=com.mysql.cj.jdbc.Driver
HOSPITAL_DB_URL=jdbc:mysql://127.0.0.1:3306/hospt?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
HOSPITAL_DB_USERNAME=<database-user>
HOSPITAL_DB_PASSWORD=<database-password>
