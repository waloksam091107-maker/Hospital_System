<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  <!-- Descriptor mappings run in this order before annotation-discovered filters. -->
  <filter><filter-name>encoding</filter-name><filter-class>com.ustb.hospital.filter.EncodingFilter</filter-class></filter>
  <filter><filter-name>audit</filter-name><filter-class>com.ustb.hospital.filter.AuditFilter</filter-class></filter>
  <filter><filter-name>authentication</filter-name><filter-class>com.ustb.hospital.filter.AuthenticationFilter</filter-class></filter>
  <filter><filter-name>csrf</filter-name><filter-class>com.ustb.hospital.filter.CsrfFilter</filter-class></filter>

  <filter-mapping><filter-name>encoding</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/appointments/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/schedules/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/medical-records/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/password/reset</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/audit-logs/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/portal/profile/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/portal/balance/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>audit</filter-name><url-pattern>/portal/admin/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/appointments/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/medical-records/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/schedules/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/date</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/password/reset</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/audit-logs/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/security/csrf</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/portal/profile/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/portal/balance/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/portal/admin/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/appointments/book</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/appointments/cancel</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/appointments/reschedule</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/appointments/start</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/appointments/complete</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/medical-records/draft</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/medical-records/finalize</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/schedules/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/password/reset</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/portal/profile/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/portal/balance/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>csrf</filter-name><url-pattern>/portal/admin/*</url-pattern></filter-mapping>
</web-app>
