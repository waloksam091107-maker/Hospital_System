<script type="text/javascript">

  $("#inputView").on("input", function (event) {
    var keyword = $.trim(this.value);
    // ajax搜索
    $.ajax({
      type: "GET",
      url: "/find?keyword=" + keyword,
      //datatype: "json", //////
      success: function (data) {
        // 将返回的 JSON 字符串解析为 JavaScript 对象数组
        var dataArray = JSON.parse(data);

        if (keyword === '') {
          $("#result").html("<p>关键词不得为空</p>");
        } else if (dataArray.length === 0) {
          $("#result").html("<p>暂无搜索结果</p>");
        } else {
          // 清空结果区域
          $("#result").empty();
          // 循环遍历列表

          for (var i = 0; i < dataArray.length; i++) {
            var deptname = dataArray[i].departmentName;
            var deptid = dataArray[i].departmentId; // 获取每个部门的ID

            // 将deptid设置为option元素的value属性
            $("#result").append('<option class="suggestion" value="' + deptid + '">' + deptname + "</option>");
          }

        }
      },
      error: function () {
        console.log("服务器错误");
      }
    });
  });

  // 监听点击事件
  $("#result").on("click", ".suggestion", function () {
    var selectedDeptName = $(this).text();
    $("#inputView").val(selectedDeptName);
  });

  function initDocList(p,docName,jobNumber,deptId){

    $.ajax({
      url: '/portal/doctors',
      type: 'GET',
      data: {"pageNum":p, "deptId":deptId,"docName":docName,"jobNumber":jobNumber},
      dataType: "json",
      success: function (res) {

        console.log("res",res)
        $("#docBody").empty();
        $.each(res.list, function (i, v) {
          var trObj = $("<tr></tr>");
          trObj.append($("<td>" + (i+1) + "</td>"));
          trObj.append($("<td>" + v.jobNumber + "</td>"));
          trObj.append($("<td>" + v.name + "</td>"));
          trObj.append($("<td>" + v.phone + "</td>"));
          trObj.append($("<td>" + v.registrationFee + "</td>"));
          trObj.append($("<td>" + v.entryDate + "</td>"));
          trObj.append($("<td>" + v.departments.departmentName + "</td>"));
          trObj.append($("<td>" + v.professionalTitles.titleName + "</td>"));
          trObj.append($("<td><div class='button-group'> " +
                  "<a class='button border-main' href='/doctors/edit-page?doctorId="+v.doctorId+"'><span class='icon-edit'></span> 修改</a > " +
                  "<a class='button border-red' href='javascript:void(0)' onclick='return confirmDeletion(" + v.doctorId + ")'><span class='icon-trash-o'></span> 删除</a > </div></td>"));
          trObj.appendTo($("#docBody"));
        });

        $(".pagelist span").remove()

        for(var i=0;i<res.pages;i++){
          var $span=$("<span onclick='changePage($(this).html())'>"+(i+1)+"</span>")

          if((i+1)==res.pageNum){
            $span.attr("class","current")
          }
          $("#next").before($span)
        }
      }
    });
  }
  $(function(){
    initDocList(1,"","",-1);  //默认为-1，记得改
  })

  function changePage(p) {
    var docName = $('input[name="docName"]').val().trim();
    var jobNumber = $('input[name="jobNumber"]').val().trim();
    var deptId = $("select[name='deptId']").val();

    // 调试输出当前参数值
    console.log("Page:", p);
    console.log("DocName:", docName);
    console.log("JobNumber:", jobNumber);
    console.log("DeptId:", deptId);

    initDocList(p, docName, jobNumber, deptId);
  }


  function nextPage(){  //也要带trim那一堆代码的数据！！
    //获取当前页码
    var currentPageNumber =$("span[class='current']").text()
    // 当前页码+1 （判断最后一页那个补全）

    var $docName=$('input[name="docName"]').val().trim();
    var $jobNumber =$('input[name="jobNumber"]').val().trim();
    var $deptId=$("select[name='deptId'] option:selected").val();
    initDocList(Number(currentPageNumber)+1,$docName,$jobNumber,$deptId)  //1+1=11? zhuanshuzi

  }


  //搜索
  function changesearch(){
    // alert("点击查询")
    var $docName=$('input[name="docName"]').val().trim();
    var $jobNumber =$('input[name="jobNumber"]').val().trim();
    var $deptId=$("select[name='deptId'] option:selected").val();
    console.log($docName,$jobNumber,$deptId);
    // alert("222")
    initDocList(1,$docName,$jobNumber,$deptId)

