  function confirmDeletion(doctorId) {
    var confirmation = confirm("确定删除吗？");
    if (confirmation) {
      // alert(doctorId)
      $.ajax({
        url: '/doctors/delete', // 服务器端点URL
        type: 'POST', // 或者使用'DELETE'，但注意跨浏览器兼容性和服务器配置
        data: {doctorId: doctorId}, // 发送的数据

        success: function () {
          alert('删除成功');
          window.location.href = 'doctors.jsp';
        },
        error: function () {
          alert('删除失败');
        },
      });
    } else {
      // 用户取消删除，不执行任何操作（或执行其他逻辑）
      alert('删除已取消');
    }
  }

