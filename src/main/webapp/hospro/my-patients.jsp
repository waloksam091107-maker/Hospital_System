    function changePage(p){


        var $idCardNumber =$('input[name="idCardNumber"]').val().trim();
        var $name=$('input[name="name"]').val().trim();
        var $phone=$('input[name="phone"]').val().trim();
        initPatientList(p,$idCardNumber,$name,$phone)


        //initDocList(p)
    }
    function firstPage(){
        var $idCardNumber =$('input[name="idCardNumber"]').val().trim();
        var $name=$('input[name="name"]').val().trim();
        var $phone=$('input[name="phone"]').val().trim();
        initPatientList(1,$idCardNumber,$name,$phone)
    }
    function prePage(){  //也要带trim那一堆代码的数据！！
        //获取当前页码
        var currentPageNumber =$("span[class='current']").text();
        // alert(currentPageNumber)
        // 当前页码+1 （判断最后一页那个补全）
        var $idCardNumber =$('input[name="idCardNumber"]').val().trim();
        var $name=$('input[name="name"]').val().trim();
        var $phone=$('input[name="phone"]').val().trim();

        initPatientList(Number(currentPageNumber)-1,$idCardNumber,$name,$phone)  //1+1=11? zhuanshuzi


    }


    function nextPage(){  //也要带trim那一堆代码的数据！！
        //获取当前页码
        var currentPageNumber =$("span[class='current']").text();
        // 当前页码+1 （判断最后一页那个补全）
        var $idCardNumber =$('input[name="idCardNumber"]').val().trim();
        var $name=$('input[name="name"]').val().trim();
        var $phone=$('input[name="phone"]').val().trim();
        initPatientList(Number(currentPageNumber)+1,$idCardNumber,$name,$phone)  //1+1=11? zhuanshuzi
