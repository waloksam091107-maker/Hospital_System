<script type="text/javascript">

    function initPatientList(p,idCardNumber,name,phone){

        $.ajax({
            url: '/patient/list',
            type: 'GET',
            data: {"pageNum":p, "idCardNumber":idCardNumber,"name":name,"phone":phone},
            dataType: "json",
            success: function (res) {
                console.log("res",res)
                $("#patientBody").empty();
                $.each(res.list, function (i, v) {
                    var trObj = $("<tr></tr>");
                    trObj.append($("<td>" + (i+1) + "</td>"));
                    trObj.append($("<td>" + v.idCardNumber + "</td>"));
                    trObj.append($("<td>" + v.name + "</td>"));
                    trObj.append($("<td>" + v.phone + "</td>"));
                    trObj.append($("<td>" + v.email + "</td>"));
                    trObj.append($("<td>" + v.balance + "</td>"));
                    trObj.append($("<td><div class='button-group'> " +
                        "<a class='button border-main' href='/patienttoEdit?patientId="+v.patientId+"'><span class='icon-edit'></span> 修改</a >" +
                        "<a class='button border-red' href='javascript:void(0)' onclick='return confirmDeletion(" + v.patientId + ")'><span class='icon-trash-o'></span> 删除</a > </div></td>"));
                    trObj.appendTo($("#patientBody"));
                });

                $(".pagelist span").remove()

                for(var i=0;i<res.pages;i++){
                    var $span=$("<span onclick='changePage($(this).html())'>"+(i+1)+"</span>")

                    if((i+1)==res.pageNum){
                        $span.attr("class","current")
                    }
                    $("#next").before($span)
                }
            }
        });
    }
    $(function(){
        initPatientList(1,"","","");  //默认为-1，记得改
