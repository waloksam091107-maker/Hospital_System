<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ustb.hospital.mapper.MenuMapper">
















    <delete id="delById">
        delete from menu where id = #{id}
    </delete>

    <select id="selectAll" resultType="map">
        select * from menu
    </select>

    <select id="selectByClass" resultType="map">
        select * from menu where fenlei = #{fenlei}
    </select>

    <select id="selectCategories" resultType="string">
        select distinct fenlei from menu where fenlei is not null and trim(fenlei) &lt;&gt; '' order by fenlei
    </select>


    <update id="updateById" >
        UPDATE menu
        SET
            price=#{price},
            fenlei=#{fenlei}

        WHERE
            id=#{id}
    </update>












































































</mapper>
