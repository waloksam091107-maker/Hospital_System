<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ustb.hospital.mapper.AuditLogsMapper">
    <resultMap id="auditLogMap" type="com.ustb.hospital.entity.AuditLog">
        <id column="audit_log_id" property="auditLogId"/>
        <result column="actor_role" property="actorRole"/><result column="actor_id" property="actorId"/>
        <result column="action" property="action"/><result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/><result column="outcome" property="outcome"/>
        <result column="request_method" property="requestMethod"/><result column="request_path" property="requestPath"/>
        <result column="remote_address" property="remoteAddress"/><result column="created_at" property="createdAt"/>
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="auditLogId">
        INSERT INTO audit_logs(actor_role, actor_id, action, target_type, target_id, outcome, request_method, request_path, remote_address)
        VALUES (#{actorRole}, #{actorId}, #{action}, #{targetType}, #{targetId}, #{outcome}, #{requestMethod}, #{requestPath}, #{remoteAddress})
    </insert>
    <select id="selectRecent" resultMap="auditLogMap">
        SELECT * FROM audit_logs ORDER BY audit_log_id DESC LIMIT #{limit}
    </select>
    <sql id="searchWhere">
        <where>
            <if test="start != null">AND created_at &gt;= #{start}</if>
            <if test="end != null">AND created_at &lt; #{end}</if>
            <if test="role != null">AND actor_role = #{role}</if>
            <if test="actorId != null">AND actor_id = #{actorId}</if>
            <if test="action != null">AND action IN <foreach collection="actionAliases" item="alias" open="(" separator="," close=")">#{alias}</foreach></if>
            <if test="outcome != null">AND outcome = #{outcome}</if>
        </where>
    </sql>
    <select id="countSearch" resultType="long">SELECT COUNT(*) FROM audit_logs <include refid="searchWhere"/></select>
    <select id="search" resultMap="auditLogMap">
        SELECT * FROM audit_logs <include refid="searchWhere"/>
        ORDER BY created_at DESC, audit_log_id DESC LIMIT #{pageSize} OFFSET #{offset}
    </select>
</mapper>
