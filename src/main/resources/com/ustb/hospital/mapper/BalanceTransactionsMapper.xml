<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ustb.hospital.mapper.BalanceTransactionsMapper">
    <resultMap id="BalanceTransactionMap" type="com.ustb.hospital.entity.BalanceTransaction">
        <id column="transaction_id" property="transactionId"/>
        <result column="patient_id" property="patientId"/>
        <result column="appointment_id" property="appointmentId"/>
        <result column="transaction_type" property="transactionType"/>
        <result column="amount" property="amount"/>
        <result column="balance_after" property="balanceAfter"/>
        <result column="created_at" property="createdAt"/>
        <result column="note" property="note"/>
    </resultMap>

    <insert id="insert" parameterType="com.ustb.hospital.entity.BalanceTransaction"
            useGeneratedKeys="true" keyProperty="transactionId">
        INSERT INTO balance_transactions(patient_id, appointment_id, transaction_type, amount, balance_after, note)
        VALUES(#{patientId}, #{appointmentId}, #{transactionType}, #{amount}, #{balanceAfter}, #{note})
    </insert>

    <select id="selectRecentByPatient" resultMap="BalanceTransactionMap">
        SELECT transaction_id, patient_id, appointment_id, transaction_type, amount, balance_after, created_at, note
        FROM balance_transactions
        WHERE patient_id = #{patientId}
        ORDER BY created_at DESC, transaction_id DESC
        LIMIT #{limit}
    </select>
</mapper>
